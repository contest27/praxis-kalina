---
interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
}
const { title, lead, eyebrow } = Astro.props;
---

<section class="pagehead">
  <div class="container pagehead__inner">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>

<style>
  .pagehead {
    background: linear-gradient(160deg, var(--rose-100) 0%, #fff 70%);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .pagehead__inner {
    text-align: center;
  }
  /* Überschrift darf die volle Containerbreite nutzen, damit sie nicht
     unnötig umbricht (der schmale Lesecontainer ist für Fließtext gedacht). */
  .pagehead h1 {
    margin-top: 0.3rem;
  }
  /* Untertitel bleibt schmal — gute Lesbarkeit statt überlanger Zeilen. */
  .pagehead .lead {
    margin-top: 0.85rem;
    max-width: 44rem;
    margin-inline: auto;
  }
</style>
