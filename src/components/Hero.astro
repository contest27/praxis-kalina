---
import { Icon } from 'astro-icon/components';
import { withBase } from '../lib/url';
import OpenNowBadge from './OpenNowBadge.astro';
import praxis from '../content/praxis/praxisdaten.json';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1 class="hero__title">{title}</h1>
      {lead && <p class="lead hero__lead">{lead}</p>}
      <div class="hero__actions">
        <a class="btn btn--primary" href={praxis.bookingUrl} target="_blank" rel="noopener">
          <Icon name="lucide:calendar-check" /> Termin online buchen
        </a>
        <a class="btn btn--ghost" href={withBase('/leistungen')}>
          Unsere Leistungen <Icon name="lucide:arrow-right" />
        </a>
      </div>
    </div>

    <aside class="hero__card" aria-label="Sprechzeiten und Kontakt">
      <OpenNowBadge />
      <a class="hero__row" href={`tel:${praxis.telefonHref}`}>
        <Icon name="lucide:phone" />
        <span><strong>{praxis.telefon}</strong><small>Wir sind für Sie da</small></span>
      </a>
      <p class="hero__row">
        <Icon name="lucide:map-pin" />
        <span><strong>{praxis.strasse}</strong><small>{praxis.plz} {praxis.ort}</small></span>
      </p>
      <a class="hero__cardlink" href={withBase('/kontakt')}>
        Sprechzeiten &amp; Anfahrt <Icon name="lucide:arrow-right" />
      </a>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(160deg, var(--rose-100) 0%, #fff 62%);
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -18%;
    right: -8%;
    width: 40rem;
    height: 40rem;
    background: radial-gradient(circle, rgba(138, 22, 42, 0.06), transparent 60%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.35fr 0.9fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(2.75rem, 7vw, 5.5rem);
  }
  .hero__title {
    font-size: var(--fs-2xl);
    max-width: 16ch;
  }
  .hero__lead {
    margin-top: 1.1rem;
    max-width: 46ch;
    color: var(--ink);
  }
  .hero__actions {
    margin-top: 1.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .hero__card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    display: grid;
    gap: 1rem;
  }
  .hero__row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: var(--ink);
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .hero__row :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
    color: var(--burgundy);
    flex: none;
  }
  .hero__row strong {
    display: block;
    font-family: var(--font-brand);
    font-weight: 600;
  }
  .hero__row small {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
  }
  a.hero__row:hover strong {
    color: var(--burgundy);
  }
  .hero__cardlink {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .hero__cardlink :global(svg) {
    width: 1.05em;
    height: 1.05em;
    transition: transform var(--t-fast) var(--ease);
  }
  .hero__cardlink:hover :global(svg) {
    transform: translateX(3px);
  }

  @media (max-width: 820px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__card {
      max-width: 26rem;
    }
  }
</style>
