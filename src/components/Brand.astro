---
/** Wortmarke mit Blüten-Emblem (Platzhalter — echtes Logo der Ärztin ersetzt es später). */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<span class:list={['brand', { 'brand--compact': compact }]}>
  <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <g fill="currentColor">
      <circle cx="16" cy="8.8" r="3.5" />
      <circle cx="22.8" cy="13.6" r="3.5" />
      <circle cx="20.2" cy="21.8" r="3.5" />
      <circle cx="11.8" cy="21.8" r="3.5" />
      <circle cx="9.2" cy="13.6" r="3.5" />
    </g>
    <circle cx="16" cy="16" r="3.3" fill="#fff" />
  </svg>
  <span class="brand__text">
    <span class="brand__name">Dorothee&nbsp;Kalina</span>
    <span class="brand__tag">Frauenarztpraxis · Leverkusen</span>
  </span>
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--burgundy);
    line-height: 1.1;
  }
  .brand__mark {
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    color: var(--burgundy);
    filter: drop-shadow(0 1px 1px rgba(42, 12, 23, 0.15));
  }
  .brand__text {
    display: flex;
    flex-direction: column;
  }
  .brand__name {
    font-family: var(--font-brand);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--burgundy);
  }
  .brand__tag {
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .brand--compact .brand__tag {
    display: none;
  }
</style>
