---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import OpeningHours from '../components/OpeningHours.astro';
import OpenNowBadge from '../components/OpenNowBadge.astro';
import Anfahrt from '../components/Anfahrt.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import praxis from '../content/praxis/praxisdaten.json';

const faqs = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Kontakt & Termine"
  description="So erreichen Sie die Frauenarztpraxis Dorothee Kalina in Leverkusen – Telefon, Sprechzeiten, Anfahrt und Online-Terminbuchung."
  structuredData={true}
>
  <PageHeader
    eyebrow="Kontakt & Termine"
    title="So erreichen Sie uns"
    lead="Vereinbaren Sie einen Termin oder stellen Sie uns Ihre Frage – wir sind gern für Sie da."
  />

  <section class="section">
    <div class="container kontakt">
      <div class="kontakt__card">
        <OpenNowBadge />
        <ul class="kontakt__rows">
          <li>
            <a href={`tel:${praxis.telefonHref}`}>
              <Icon name="lucide:phone" />
              <span><strong>{praxis.telefon}</strong><small>Telefon</small></span>
            </a>
          </li>
          <li>
            <span class="kontakt__row">
              <Icon name="lucide:printer" />
              <span><strong>{praxis.fax}</strong><small>Fax</small></span>
            </span>
          </li>
          <li>
            <a href={`mailto:${praxis.email}`}>
              <Icon name="lucide:mail" />
              <span><strong>{praxis.email}</strong><small>E-Mail</small></span>
            </a>
          </li>
          <li>
            <span class="kontakt__row">
              <Icon name="lucide:map-pin" />
              <span><strong>{praxis.strasse}</strong><small>{praxis.plz} {praxis.ort}</small></span>
            </span>
          </li>
        </ul>
        <a class="btn btn--primary kontakt__book" href={praxis.bookingUrl} target="_blank" rel="noopener">
          <Icon name="lucide:calendar-check" /> Termin online buchen
        </a>
        <p class="kontakt__hint">{praxis.hinweisTermin}</p>
      </div>

      <div class="kontakt__hours">
        <h2>Sprechzeiten</h2>
        <OpeningHours />
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Anfahrt</span>
        <h2>Wo Sie uns finden</h2>
      </div>
      <Anfahrt />
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <div class="section-head">
        <span class="eyebrow">Häufige Fragen</span>
        <h2>Gut zu wissen</h2>
      </div>
      <FaqAccordion items={faqs} />
    </div>
  </section>
</BaseLayout>

<style>
  .kontakt {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .kontakt__card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow);
    padding: clamp(1.4rem, 3vw, 2rem);
  }
  .kontakt__rows {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.2rem;
  }
  .kontakt__rows a,
  .kontakt__row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }
  .kontakt__rows :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
    color: var(--burgundy);
    flex: none;
  }
  .kontakt__rows strong {
    display: block;
    font-family: var(--font-brand);
    font-weight: 600;
  }
  .kontakt__rows small {
    display: block;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .kontakt__rows a:hover strong {
    color: var(--burgundy);
  }
  .kontakt__book {
    margin-top: 1.3rem;
    width: 100%;
  }
  .kontakt__hint {
    margin-top: 0.9rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .kontakt__hours {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: clamp(1.4rem, 3vw, 2rem);
  }
  .kontakt__hours h2 {
    margin-bottom: 0.6rem;
  }
  @media (max-width: 760px) {
    .kontakt {
      grid-template-columns: 1fr;
    }
  }
</style>
