---
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services
    .filter((s) => !s.data.draft)
    .map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const others = (await getCollection('services'))
  .filter((s) => !s.data.draft && s.id !== service.id)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={service.data.title} description={service.data.summary}>
  <PageHeader eyebrow="Leistung" title={service.data.title} lead={service.data.summary} />

  <section class="section">
    <div class="container detail">
      <article class="prose detail__body">
        <Content />
      </article>

      <aside class="detail__aside" aria-label="Weitere Leistungen">
        <h2 class="detail__asidehead">Weitere Leistungen</h2>
        <ul class="detail__others">
          {
            others.map((s) => (
              <li>
                <a href={withBase(`/leistungen/${s.id}`)}>
                  <Icon name={`lucide:${s.data.icon}`} />
                  <span>{s.data.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="detail__back" href={withBase('/leistungen')}>
          <Icon name="lucide:arrow-left" /> Alle Leistungen
        </a>
      </aside>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .detail {
    display: grid;
    grid-template-columns: 1fr 18rem;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: start;
  }
  .detail__body {
    max-width: 42rem;
    font-size: var(--fs-md);
  }
  .detail__aside {
    position: sticky;
    top: calc(var(--header-h) + 1rem);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 1.5rem;
  }
  .detail__asidehead {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }
  .detail__others {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .detail__others a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.6rem;
    border-radius: var(--r-sm);
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
  }
  .detail__others a:hover {
    background: var(--rose);
    color: var(--burgundy);
  }
  .detail__others :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--burgundy);
    flex: none;
  }
  .detail__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.1rem;
    font-weight: 600;
    text-decoration: none;
  }
  .detail__back :global(svg) {
    width: 1.05em;
    height: 1.05em;
  }
  @media (max-width: 820px) {
    .detail {
      grid-template-columns: 1fr;
    }
    .detail__aside {
      position: static;
    }
  }
</style>
